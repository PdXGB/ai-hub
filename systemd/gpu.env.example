# /etc/groot-ai/gpu.env - read by nvidia-power-limit.service and comfyui (gpu.conf).
# setup.sh writes this from `nvidia-smi -L`.
GPU_MAIN_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GPU_MAIN_POWER_LIMIT=325
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
