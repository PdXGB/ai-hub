# /etc/aihub/gpu.env - read by aihub-gpu-power (nvidia-power-limit.service) and comfyui (gpu.conf).
# setup.sh writes this from nvidia-smi. One UUID and power limit (watts) per card;
# an empty limit leaves that card at its stock limit. One GPU: GPU_HA_UUID is the
# main card's UUID and GPU_HA_POWER_LIMIT stays empty.
GPU_MAIN_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GPU_MAIN_POWER_LIMIT=325
GPU_HA_UUID=GPU-yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy
GPU_HA_POWER_LIMIT=170
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
