[Unit]
Description=Set NVIDIA GPU power limits (per card)
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
# Reads GPU_<ROLE>_UUID / GPU_<ROLE>_POWER_LIMIT from /etc/aihub/gpu.env (written by setup.sh).
# An empty limit leaves that card at stock. Re-apply after editing: sudo systemctl restart nvidia-power-limit
ExecStart=/usr/local/bin/aihub-gpu-power
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
