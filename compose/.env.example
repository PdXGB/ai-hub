# ai-hub environment file.
# scripts/setup.sh generates /srv/ai/.env from this template.
# Or copy it to /srv/ai/.env and fill it in by hand. NEVER commit .env.

# --- LiteLLM (model router) ---
# Admin key for the proxy (starts with sk-). Generated by setup.sh.
LITELLM_MASTER_KEY=
# Encrypts keys stored in LiteLLM's DB. Generated. Never change it after first start.
LITELLM_SALT_KEY=
# Generated.
LITELLM_DB_PASSWORD=

# --- Open WebUI ---
# Generated.
WEBUI_SECRET_KEY=

# --- n8n ---
# Generated. BACK THIS UP: without it, saved n8n credentials can't be decrypted.
N8N_ENCRYPTION_KEY=
# Generated.
N8N_DB_PASSWORD=
# Public hostname for n8n through the Cloudflare tunnel, e.g. n8n.example.com
N8N_HOSTNAME=
# Public hostname for Open WebUI, e.g. chat.example.com (used for the tunnel route)
CHAT_HOSTNAME=

# --- Cloud model providers (leave blank to skip one) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# --- Cloudflare tunnel ---
# Token from Zero Trust > Networks > Tunnels > (your tunnel) > Docker install command.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Host ---
# Timezone for n8n, Whisper and Piper (tz database name, e.g. Europe/London).
TZ=
# The server's LAN IP. LiteLLM, Whisper and Piper bind here so LAN clients
# (Home Assistant) can reach them; everything else stays on localhost.
AIHUB_LAN_IP=
# GPU UUIDs from `nvidia-smi -L`. setup.sh detects these.
# MAIN = big card (LLMs, ComfyUI). HA = second card for Home Assistant
# workloads; with a single GPU, set it to the same UUID as MAIN.
GPU_MAIN_UUID=
GPU_HA_UUID=
