# Networks allowed to SSH in without an alert (space separated). Add a VPN/Tailscale range if you use one.
ALLOWED_NETS="<YOUR_LAN_CIDR> <YOUR_OTHER_LAN_CIDR> 127.0.0.0/8 ::1/128 fe80::/10"
# Failed SSH attempts in 24 h before alerting
SSH_FAIL_ALERT=10
# Monthly cloud budget in USD (matches LiteLLM max_budget)
CLOUD_BUDGET=50
# --- Optional (defaults shown in /usr/local/bin/aihub-mon) ---
# Pin GPU roles by UUID; otherwise main = most VRAM, HA = next card
#GPU_MAIN_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#GPU_HA_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Expected GPU count (default: NVIDIA GPUs lspci sees); "GPU" goes OFF if fewer answer
#GPU_COUNT=2
# Disks checked for the "Disks" sensor, and the alert threshold
#DISK_MOUNTS="/ /srv/models/ollama /srv/models/comfyui /srv/backup"
#DISK_ALERT_PCT=85
# Backup age checks ("Backups" sensor); empty value disables a check
#BACKUP_DIR=/srv/backup
#BACKUP_MAX_AGE_H=26
NAS_BACKUP_DIR=/mnt/nas/aihub
#NAS_MAX_AGE_H=27
#COMFYUI_UNIT=comfyui.service
# Monthly restore drill result (written by aihub-restore-drill; "Restore test" sensor); empty path disables it
#RESTORE_STATE=/var/lib/aihub-mon/restore-drill.json
#RESTORE_MAX_AGE_D=36
