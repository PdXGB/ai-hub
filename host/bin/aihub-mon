    (S, "disk_free_gb", "Disk free", "GB", "data_size", "measurement", None, {}),
    (S, "boot_time", "Last boot", None, "timestamp", None, None, {}),
    (S, "gpu_temp", "GPU temperature", "°C", "temperature", "measurement", None, {}),
    (S, "gpu_util", "GPU utilization", "%", None, "measurement", "mdi:expansion-card", {}),
    (S, "vram_used_pct", "VRAM used", "%", None, "measurement", "mdi:memory", {}),
    (S, "vram_used_gb", "VRAM used GB", "GB", "data_size", "measurement", None, {}),
    (S, "vram_free_gb", "VRAM free GB", "GB", "data_size", "measurement", None, {}),
    (S, "gpu_power", "GPU power", "W", "power", "measurement", None, {}),
    (S, "gpu_ha_temp", "HA GPU temperature", "°C", "temperature", "measurement", None, {}),
    (S, "gpu_ha_util", "HA GPU utilization", "%", None, "measurement", "mdi:expansion-card", {}),
    (S, "vram_ha_used_pct", "HA GPU VRAM used", "%", None, "measurement", "mdi:memory", {}),
    (S, "vram_ha_used_gb", "HA GPU VRAM used GB", "GB", "data_size", "measurement", None, {}),
    (S, "vram_ha_free_gb", "HA GPU VRAM free GB", "GB", "data_size", "measurement", None, {}),
    (S, "gpu_ha_power", "HA GPU power", "W", "power", "measurement", None, {}),
    (S, "gpu_count", "GPUs detected", None, None, "measurement", "mdi:expansion-card-variant", {"attr": "gpus"}),
    (S, "disk_max_used_pct", "Fullest disk", "%", None, "measurement", "mdi:harddisk", {"attr": "disk_mounts"}),
