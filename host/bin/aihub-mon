BUTTONS = [("ack_alerts", "Acknowledge alerts", "accept", "mdi:shield-check"),
           ("check_updates", "Check updates now", "check_updates", "mdi:update")]


def discovery_payloads(services):
    msgs = []
    for key, name, payload, icon in BUTTONS:
        p = {"name": name, "unique_id": f"aihub_{key}", "command_topic": f"{BASE}/cmd",
             "payload_press": payload, "icon": icon, "device": DEVICE,
             "availability_topic": f"{BASE}/listener", "payload_available": "online", "payload_not_available": "offline"}
        msgs.append((f"{PREFIX}/button/aihub/{key}/config", json.dumps(p)))
    for comp, key, name, unit, dc, sc, icon, ex in ENTITIES:
        topic = f"{BASE}/{ex.get('topic', 'state')}"
        p = {"name": name, "unique_id": f"aihub_{key}", "state_topic": topic,
             "value_template": f"{{{{ value_json.{key} }}}}", "device": DEVICE}
        if key == "online":
            p["value_template"] = "ON"
        if ex.get("topic") != "updates":
            p["expire_after"] = 180          # goes unavailable if the server stops reporting
        if unit: p["unit_of_measurement"] = unit
        if dc: p["device_class"] = dc
        if sc: p["state_class"] = sc
        if icon: p["icon"] = icon
        if comp == B: p["payload_on"], p["payload_off"] = "ON", "OFF"
        if "attr" in ex:
            p["json_attributes_topic"] = topic
            p["json_attributes_template"] = f"{{{{ {{'items': value_json.{ex['attr']}}} | tojson }}}}"
        msgs.append((f"{PREFIX}/{comp}/aihub/{key}/config", json.dumps(p)))
    for svc in services:
        p = {"name": f"Container {svc}", "unique_id": f"aihub_container_{svc}", "state_topic": f"{BASE}/state",
             "value_template": f"{{{{ value_json.containers['{svc}'].state if '{svc}' in value_json.containers else 'missing' }}}}",
             "json_attributes_topic": f"{BASE}/state",
             "json_attributes_template": f"{{{{ {{'status': value_json.containers['{svc}'].status if '{svc}' in value_json.containers else ''}} | tojson }}}}",
             "icon": "mdi:docker", "expire_after": 180, "device": DEVICE}
        msgs.append((f"{PREFIX}/sensor/aihub/container_{svc}/config", json.dumps(p)))
    return msgs


def publish(topic, payload, retain=False, dry=False):
    if dry:
        print(f"{topic}  {payload}")
        return
    cmd = ["mosquitto_pub", "-q", "1", "-t", topic, "-m", payload] + (["-r"] if retain else [])
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    if r.returncode:
        print(f"mosquitto_pub failed for {topic}: {r.stderr.strip()}", file=sys.stderr)


def listen():
    """Wait for button presses from HA. Marks itself online/offline so the buttons grey out if this isn't running."""
    import shlex
    conf = [a for ln in open("/root/.config/mosquitto_pub") for a in shlex.split(ln)]
    cmd = ["mosquitto_sub", *conf, "-q", "1", "-t", f"{BASE}/cmd",
           "--will-topic", f"{BASE}/listener", "--will-payload", "offline", "--will-retain"]
    publish(f"{BASE}/listener", "online", retain=True)
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
    try:
        for msg in proc.stdout:
            msg = msg.strip()
            if msg == "accept":
                accept_baseline("Home Assistant button")
                cycle()                                   # refresh HA right away
            elif msg == "check_updates":
                print("aihub-mon: update check requested from Home Assistant", file=sys.stderr)
                publish(f"{BASE}/updates", json.dumps(daily()), retain=True)
            elif msg:
                print(f"aihub-mon: ignored unknown command {msg[:40]!r}", file=sys.stderr)
    finally:
        publish(f"{BASE}/listener", "offline", retain=True)
        proc.terminate()
    sys.exit(1)   # mosquitto_sub exited (broker restart etc.); systemd restarts us


def main():
    args = sys.argv[1:]
    dry = "--dry-run" in args
    if "--accept" in args:
        accept_baseline("cli"); print("Baseline accepted and SSH/sudo alerts marked as seen."); return
    if "--daily" in args:
        u = daily()
        publish(f"{BASE}/updates", json.dumps(u), retain=True, dry=dry)
        return
    if "--listen" in args:
        listen(); return
    cycle(dry)


def cycle(dry=False):
    # every key present so HA never sees an undefined template variable; null renders as "None" -> unknown
    state = {key: None for comp, key, *_ in ENTITIES if key != "online"}
    for k in ("apt_updates", "container_updates", "firmware_updates", "updates_checked"):
        state.pop(k, None)
    state.update(system())
    state.update(health())
    c, foreign = containers()
    state.update(c)
    state.update(ai())
    state.update(security(foreign))

    sig = hashlib.sha256(json.dumps([ENTITIES, BUTTONS, sorted(c["containers"])], default=str).encode()).hexdigest()
    if dry or not os.path.exists(DISCOVERY_MARK) or open(DISCOVERY_MARK).read() != sig:
        for t, p in discovery_payloads(sorted(c["containers"])):
            publish(t, p, retain=True, dry=dry)
        u = updates()
        publish(f"{BASE}/updates", json.dumps(u), retain=True, dry=dry)
        if not dry:
            open(DISCOVERY_MARK, "w").write(sig)
    publish(f"{BASE}/state", json.dumps(state), dry=dry)


if __name__ == "__main__":
    main()
