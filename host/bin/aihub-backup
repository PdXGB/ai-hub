#!/bin/bash
set -euo pipefail
DEST=/srv/backup/$(date +%F)
mkdir -p "$DEST"
cd /srv/ai
# consistent database dumps
docker compose exec -T litellm-db pg_dump -U litellm litellm | gzip > "$DEST/litellm-db.sql.gz"
docker compose exec -T n8n-db pg_dump -U n8n n8n | gzip > "$DEST/n8n-db.sql.gz"
# configs, secrets, app data (skip raw postgres dirs and models)
tar -czf "$DEST/aihub-config.tar.gz" \
  /srv/ai /srv/data/open-webui /srv/data/n8n /srv/library \
  /srv/comfyui/user /srv/comfyui/custom_nodes \
  /etc/docker/daemon.json /etc/netplan /etc/systemd/system/comfyui.service \
  /etc/systemd/system/nvidia-power-limit.service /etc/systemd/system/comfyui-idle-free.* \
  /etc/systemd/system/nvidia-persistenced.service.d /etc/apt/apt.conf.d/51unattended-nvidia \
  /usr/local/bin/comfyui-idle-free /usr/local/bin/aihub-backup /usr/local/bin/aihub-gpu-power /usr/local/bin/aihub-restore-drill /usr/local/bin/aihub-library-index \
  /etc/aihub /etc/systemd/system/comfyui.service.d /etc/fstab \
  /usr/local/bin/aihub-mon /etc/aihub-mon.env /etc/systemd/system/aihub-* /var/lib/aihub-mon \
  /root/.config/mosquitto_pub 2>/dev/null || true
chmod -R go-rwx "$DEST"
# keep 7 days
find /srv/backup -maxdepth 1 -type d -name '20*' -mtime +6 -exec rm -rf {} +
echo "Backup OK: $DEST ($(du -sh "$DEST" | cut -f1))"
# off-box copy (mirrors the 7 local dailies) to NAS_BACKUP_DIR from /etc/aihub-mon.env; empty or unset = local only
ENV_FILE=${AIHUB_MON_ENV:-/etc/aihub-mon.env}
NAS=""
[ -r "$ENV_FILE" ] && NAS=$(sed -n 's/^[[:space:]]*NAS_BACKUP_DIR=//p' "$ENV_FILE" | tail -n 1 |
  sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/")
if [ -z "$NAS" ]; then
  [ -r "$ENV_FILE" ] && src="NAS_BACKUP_DIR empty or not set in $ENV_FILE" || src="$ENV_FILE missing or unreadable"
  echo "NAS copy skipped: $src, local backup only"
  exit 0
fi
NAS=${NAS%/}
why=""
if ! timeout 20 test -d "$NAS"; then                 # also triggers an automount; timeout guards a hung share
  why="folder missing or share not responding"
else
  mnt=$(timeout 20 findmnt -n -r -o TARGET -T "$NAS" | head -n 1 || true)
  fs=$(timeout 20 stat -f -c %T "$NAS" || true)
  dev=$(stat -c %d "$NAS" || true)
  if [ "$fs" = autofs ] || [ "$dev" = "$(stat -c %d /)" ] || [ "$dev" = "$(stat -c %d /srv/backup)" ]; then
    why="not on a mounted share (mount ${mnt:-?}, ${fs:-?})"   # never mirror onto the local disks
  fi
fi
if [ -z "$why" ]; then
  rsync -rt --delete --exclude lost+found /srv/backup/ "$NAS/"
  echo "Copied to NAS: $NAS (mount $mnt, $fs)"
else
  echo "WARNING: NAS not reachable, local backup only: $NAS: $why" >&2
fi
