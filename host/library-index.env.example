# /etc/aihub/library-index.env (root, mode 600): settings for aihub-library-index (docs/12 §6)
# An Open WebUI API key (Settings -> Account -> API Keys). Admin Panel -> Settings -> General must allow API keys;
# restrict them to: /api/v1/knowledge,/api/v1/files
OWUI_API_KEY=
# --- Optional (defaults shown) ---
#OWUI_URL=http://127.0.0.1:3000
#LIBRARY_DIR=/srv/library
#LIBRARIES="work personal"
#COLLECTION_PREFIX=library-
#EXTENSIONS=".md .txt .csv"
#MAX_FILE_MB=20
