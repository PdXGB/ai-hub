# Normalize text files and keep LF in the working tree on every OS.
# Scripts and configs run on Ubuntu (the server); CRLF breaks bash shebangs.
* text=auto eol=lf

# Windows-only scripts (if any are ever added)
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.mp4  binary
*.pdf  binary
